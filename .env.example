# Copy to .env.local for local use; never commit the filled file or a database URL.
# Server-only PostgreSQL transaction-pooler URL. Use the provider's pooled URI,
# with TLS enabled (for example sslmode=require when the provider requires it).
# Leave unset for local JSON storage; required for Vercel/production.
DATABASE_URL=

# Required for production admin access. Both must be set; the admin/admin fallback
# exists only when NODE_ENV=development and either value is missing.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required in production for signed member/admin cookies and shared login throttling.
SESSION_SECRET=

# Required in production for member score-code redemption. Set a numeric value
# that exactly matches the external game's encoder; no production default exists.
# Local development uses 98765 only when this variable is left unset.
# SCORE_CODE_KEY=

# Optional comma-separated exact college email domains. Empty uses the built-in
# academic-domain rule; this does not verify mailbox ownership.
ALLOWED_EMAIL_DOMAINS=

# Leave unset on Vercel. Only set true for a single persistent production Node
# process that intentionally uses data/event.json; serverless files are ephemeral.
ALLOW_JSON_STORAGE=

# Non-Vercel trusted proxies only: name of the client-IP header overwritten by
# your proxy on every request. Leave unset on Vercel, which uses its trusted
# x-vercel-forwarded-for header automatically.
TRUSTED_CLIENT_IP_HEADER=
